{
  "name": "codescale-ai",
  "displayName": "CodeScale AI",
  "description": "An AI-powered developer tool that analyzes code quality, optimizes inputs by handling duplicates and missing values, evaluates best- and worst-case scenarios, identifies inefficiencies, assesses time and space complexity, and recommends validated code improvements for better performance and scalability.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codescale-ai.helloWorld",
        "title": "CodeScale AI: Hello World"
      },
      {
        "command": "codescale-ai.setApiKey",
        "title": "CodeScale AI: Set Groq API Key"
      },
      {
        "command": "codescale-ai.checkApiKey",
        "title": "CodeScale AI: Check Groq API Key"
      },
      {
        "command": "codescale-ai.testGroq",
        "title": "CodeScale AI: Test Groq Connection"
      },
      {
        "command": "codescale-ai.openChat",
        "title": "CodeScale AI: Open Chat"
      },
      {
        "command": "codescale-ai.readWorkspace",
        "title": "CodeScale AI: Read Workspace"
      },
      {
        "command": "codescale-ai.analyzeCurrentFile",
        "title": "CodeScale AI: Analyze Current File"
      },
      {
        "command": "codescale-ai.benchmarkFunction",
        "title": "CodeScale AI: Benchmark Function"
      },
      {
        "command": "codescale-ai.suggestDSA",
        "title": "CodeScale AI: Suggest Data Structures"
      },
      {
        "command": "codescale-ai.suggestTests",
        "title": "CodeScale AI: Suggest Tests"
      },
      {
        "command": "codescale-ai.verifyImplementations",
        "title": "CodeScale AI: Verify Optimized Version"
      },
      {
        "command": "codescale-ai.findWorstCase",
        "title": "CodeScale AI: Find Worst-Case Input"
      },
      {
        "command": "codescale-ai.compareImplementations",
        "title": "CodeScale AI: Find Crossover Between Two Versions"
      },
      {
        "command": "codescale-ai.runTests",
        "title": "CodeScale AI: Run Tests"
      },
      {
        "command": "codescale-ai.scanSecrets",
        "title": "CodeScale AI: Scan for Secrets"
      },
      {
        "command": "codescale-ai.optimizeWithAI",
        "title": "CodeScale AI: Optimize with AI (Diff Preview)"
      },
      {
        "command": "codescale-ai.showHistory",
        "title": "CodeScale AI: Show History"
      },
      {
        "command": "codescale-ai.exportReport",
        "title": "CodeScale AI: Export Report"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.13.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0"
  }
}